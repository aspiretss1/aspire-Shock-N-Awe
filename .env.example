# Analytics container per brand.
# An UNSET id must render NO tag — never interpolate it into a script URL.
# `next.config.mjs` fails the production build if these are missing.
NEXT_PUBLIC_GTM_ASAT=GTM-XXXXXXX
NEXT_PUBLIC_GTM_ASPIRE=GTM-YYYYYYY

# Optional
NEXT_PUBLIC_GA4_ASAT=
NEXT_PUBLIC_GA4_ASPIRE=
NEXT_PUBLIC_CHAT_WIDGET_ASAT=
NEXT_PUBLIC_CHAT_WIDGET_ASPIRE=

# Local development: force a brand regardless of host.
# Without it, localhost falls back to the DEFAULT_SITE in scene/sites.ts.
# A bare VPS IP also falls back to asat — uncomment for Aspire theming there.
# NEXT_PUBLIC_FORCE_SITE=aspire

# ---------------------------------------------------------------------------
# Dynamic content
# ---------------------------------------------------------------------------

# Live scenes come from Supabase (sna_scenes). Not a local JSON catalog.
SCENE_SOURCE_URL=

# How long a loaded scene set is reused before re-reading. Default 30000.
SCENE_SOURCE_CACHE_MS=

# Shared secret for POST /api/scene/revalidate. Without it the route returns
# 501 rather than accepting unauthenticated publishes.
SCENE_REVALIDATE_SECRET=

# Extra hosts allowed inside an iframe, comma separated. The defaults in
# scene/schema.ts already cover YouTube, Vimeo, Loom, Wistia, Drive, the
# Office viewer and our own domains. Everything else redirects instead.
# NEXT_PUBLIC_ because the hotspot decides modal-vs-redirect in the browser.
NEXT_PUBLIC_SCENE_EMBED_HOSTS=

# Extra hosts for next/image, comma separated. The Supabase project host is
# added automatically from NEXT_PUBLIC_SUPABASE_URL at image build.
SCENE_IMAGE_HOSTS=

# Shared secret for POST /api/auth/handoff and POST /api/auth/logout/handoff
# (hub server only). Unset → 501 on those routes.
HANDOFF_SECRET=

# Outer dashboard. Setup shows "Return to dashboard" when this is http(s).
# Also used for global sign-out: after local logout, the browser navigates to
# {DASHBOARD_URL}/logout (or DASHBOARD_LOGOUT_URL) — the hub SPA page that
# clears the CMS session and fans out to other apps.
# Logout handoff `next` must be on the DASHBOARD_URL origin.
# DASHBOARD_URL=https://hub.example.com
DASHBOARD_URL=
# Optional full URL override for hub logout (default: {DASHBOARD_URL}/logout).
# DASHBOARD_LOGOUT_URL=https://hub.example.com/logout
DASHBOARD_LOGOUT_URL=

# ---------------------------------------------------------------------------
# Supabase (required for Setup writes, uploads, and admin login)
# ---------------------------------------------------------------------------
# Create the project, then run supabase/schema.sql in the SQL editor.
# Tables: sna_scenes, sna_media, app_users (id, email, role — seed role = admin).
# Files go in Storage (image, PDF, video, audio). YouTube stays an https URL.
# Data: URL + service role. Auth cookies: publishable key (sb_publishable_…).
# Neither key belongs in NEXT_PUBLIC_ except the project URL.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Public origin of this engine, used by SAT/Aspire fetch helpers.
# Docker Compose reads this file as `.env` (copy from `.env.example`) and the
# app listens on 127.0.0.1:5000. Host Caddy on 80/443 proxies HTTPS here.
# NEXT_PUBLIC_SUPABASE_URL is also passed as a build arg so the standalone
# image can reach the project.
# SCENE_ENGINE_URL=http://localhost:5000
# SCENE_ENGINE_URL=https://shock-n-awe.duckdns.org
SCENE_ENGINE_URL=
